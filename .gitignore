# =============================================================================
# .gitignore — audio deepfake detection (Python / Jupyter / PyTorch)
# =============================================================================

# -------- Python bytecode & caches --------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/
develop-eggs/
sdist/
.installed.cfg
*.manifest
*.spec

# -------- Virtual envs --------
venv/
.venv/
env/
.env
.envrc

# -------- Jupyter / Colab --------
.ipynb_checkpoints/
*.nbcheckpoint
.jupyter/
.cache/

# -------- Local data & model artefacts (never commit ~GB of audio) --------
# Raw datasets and model checkpoints should live on Drive / Kaggle, not in git.
data/
datasets/
asvspoof*/
LA/
*.wav
*.flac
*.pkl
*.pth
*.pt
*.npy
*.npz
*.mat
*.h5
features/
checkpoints/
models/

# -------- Results & charts generated by the notebooks --------
# Keep the committed figures (if any) in a dedicated `figures/` folder.
results/
charts/
runs/
logs/
*.log
wandb/

# -------- IDE / editor --------
.vscode/
.idea/
*.swp
*.swo
*~

# -------- OS noise --------
.DS_Store
Thumbs.db
desktop.ini

# -------- Archives --------
*.zip
*.tar.gz
*.rar
*.7z

# -------- Secrets --------
kaggle.json
*.env
secrets.json
credentials.json
